# Din Riot API-nyckel från https://developer.riotgames.com
# Kopiera filen till .env.local och fyll i. Nyckeln stannar på servern och
# skickas aldrig till webbläsaren.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Valfritt lokalt, starkt rekommenderat på Vercel: lösenord som krävs för att
# använda nyckeln via appen.
# APP_PASSWORD=
